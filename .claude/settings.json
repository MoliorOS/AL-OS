{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(context/**)",
      "Read(skills/**)",
      "Read(roles/**)",
      "Read(docs/**)",
      "Read(*.md)",
      "git status",
      "git log",
      "git diff",
      "git add",
      "git commit"
    ],
    "ask": [
      "git push",
      "gh pr create"
    ],
    "deny": [
      "Read(//home/ubuntu/**/.env)",
      "Write(../AL-BRAIN/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  }
}
